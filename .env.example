# FinVoice & Sarvam OCR Environment Configuration

# 1. Sarvam AI API Key (Required for Document AI OCR & Vision Ingestion)
# Get your key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Database URL (Optional, defaults to local SQLite collections.db)
# DATABASE_URL=sqlite:///./data/collections.db

# 3. Cashfree Payment Gateway Settings (Optional for test simulations)
CASHFREE_APP_ID=TEST_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=TEST_CASHFREE_SECRET_KEY
CASHFREE_ENV=TEST
